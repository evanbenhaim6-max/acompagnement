<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="theme-color" content="">
<link rel="canonical" href="{{ canonical_url }}">
{%- if settings.favicon != blank -%}
<link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
{%- endif -%}
<title>
  {{ page_title }}
  {%- if current_tags %} &ndash; tagged "{{ current_tags | join: ', ' }}"{% endif -%}
  {%- if current_page != 1 %} &ndash; {{ 'general.pagination.page' | t: page: current_page }}{% endif -%}
  {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
</title>
{% if page_description %}<meta name="description" content="{{ page_description | escape }}">{% endif %}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Figtree:ital,wght@0,300..900;1,300..900&display=swap" rel="stylesheet">

{{ content_for_header }}

{{ 'base.css' | asset_url | stylesheet_tag }}
{{ 'component-cart-notification.css' | asset_url | stylesheet_tag }}
{{ 'component-cart-items.css' | asset_url | stylesheet_tag }}

<style>
  {%- for scheme in settings.color_schemes -%}
  .color-{{ scheme.id }} {
    background-color: {{ scheme.settings.background }};
    color: {{ scheme.settings.text }};
  }
  .color-{{ scheme.id }} .nas-pm-cta,
  .color-{{ scheme.id }} .gg-hero-cta,
  .color-{{ scheme.id }} .gg-pillars-cta {
    background-color: {{ scheme.settings.button }};
    color: {{ scheme.settings.button_label }};
  }
  {%- endfor -%}
  body { margin: 0; font-family: 'Figtree', -apple-system, BlinkMacSystemFont, sans-serif; overflow-x: hidden; }
  *, *::before, *::after { box-sizing: border-box; }

  .nas-promo-bar{background:#6E100F;color:#fff;text-align:center;padding:12px 16px}
  .nas-promo-bar-inner{display:flex;align-items:center;justify-content:center;gap:8px 14px;flex-wrap:wrap}
  .nas-promo-bar-title{font-size:21px;font-weight:900;letter-spacing:1px;text-transform:uppercase;line-height:1.15}
  .nas-promo-bar-title em{font-style:normal;color:#FFB15C}
  .nas-promo-bar-tag{background:#FF8A1F;color:#3A0605;font-size:13px;font-weight:900;letter-spacing:1px;text-transform:uppercase;padding:5px 12px;border-radius:50px;line-height:1.1;animation:nas-promo-pulse 1.6s ease-in-out infinite}
  .nas-promo-bar-end{display:inline-flex;align-items:center;gap:8px;font-size:14px;font-weight:700}
  .nas-promo-bar-timer{background:rgba(255,255,255,0.16);border:1px solid rgba(255,255,255,0.25);padding:4px 11px;border-radius:8px;font-variant-numeric:tabular-nums;font-weight:900;font-size:17px;letter-spacing:.5px}
  @keyframes nas-promo-pulse{0%,100%{transform:scale(1)}50%{transform:scale(1.07)}}
  @media(prefers-reduced-motion:reduce){.nas-promo-bar-tag{animation:none}}

  .nas-header{display:grid;grid-template-columns:1fr auto 1fr;align-items:center;gap:16px;padding:18px 32px;border-bottom:1px solid #eee;max-width:{{ settings.page_width }}px;margin:0 auto}
  .nas-header-menu-btn{justify-self:start;display:flex;align-items:center;justify-content:center;width:36px;height:36px;background:none;border:none;cursor:pointer;color:#1a1a1a;padding:0}
  .nas-header-menu-btn svg{width:24px;height:24px}
  .nas-header-logo{grid-column:2;display:flex;align-items:center;justify-content:center;text-decoration:none}
  .nas-header-logo img{display:block;height:28px;width:auto}
  .nas-header-actions{justify-self:end;display:flex;align-items:center;gap:14px;flex-shrink:0}
  .nas-header-icon-btn{display:flex;align-items:center;justify-content:center;width:36px;height:36px;color:#1a1a1a;position:relative;text-decoration:none}
  .nas-header-icon-btn svg{width:20px;height:20px}
  .nas-header-cart-count{position:absolute;top:-2px;right:-2px;background:#6E100F;color:#fff;font-size:10px;font-weight:700;width:16px;height:16px;border-radius:50%;display:flex;align-items:center;justify-content:center;line-height:1}

  .nas-mobile-nav{display:flex;flex-direction:column;max-width:{{ settings.page_width }}px;margin:0 auto;border-bottom:1px solid #eee;overflow:hidden;max-height:0;transition:max-height .25s ease}
  .nas-mobile-nav.nas-nav-open{max-height:240px}
  .nas-mobile-nav a{color:#1a1a1a;text-decoration:none;font-size:15px;font-weight:600;padding:14px 32px;border-top:1px solid #f5f5f5}

  .nas-footer{background:#6E100F;color:#fff;padding:60px 32px 40px}
  .nas-footer-inner{max-width:{{ settings.page_width }}px;margin:0 auto;display:grid;grid-template-columns:1.3fr 1fr 1fr;gap:40px}
  .nas-footer-brand{display:inline-block}
  .nas-footer-brand img{display:block;height:40px;width:auto;border-radius:6px}
  .nas-footer-heading{font-size:19px;font-weight:800;color:#fff;margin:0 0 18px 0}
  .nas-footer-links{display:flex;flex-direction:column;gap:12px}
  .nas-footer-links a{color:rgba(255,255,255,0.85);text-decoration:none;font-size:15px}
  .nas-footer-links a:hover{color:#fff;text-decoration:underline}
  .nas-footer-contact-email{color:#fff;font-weight:700;font-size:15px;margin:0 0 14px 0}
  .nas-footer-contact-text{color:rgba(255,255,255,0.8);font-size:14px;line-height:1.6;margin:0}
  .nas-footer-bottom{max-width:{{ settings.page_width }}px;margin:40px auto 0;padding-top:24px;border-top:1px solid rgba(255,255,255,0.15);font-size:13px;color:rgba(255,255,255,0.65)}

  .nas-sticky-atc{position:fixed;left:0;right:0;bottom:0;z-index:40;background:#fff;border-top:1px solid #eee;box-shadow:0 -4px 18px rgba(0,0,0,0.08);padding:12px 20px;padding-bottom:calc(12px + env(safe-area-inset-bottom, 0px));transform:translateY(100%);transition:transform .25s ease}
  .nas-sticky-atc.nas-sticky-atc-visible{transform:translateY(0)}
  .nas-sticky-atc-inner{max-width:{{ settings.page_width }}px;margin:0 auto;display:flex;align-items:center;gap:14px}
  .nas-sticky-atc-img{width:48px;height:48px;border-radius:8px;object-fit:cover;flex-shrink:0;background:#f5f0ed}
  .nas-sticky-atc-info{flex:1;min-width:0}
  .nas-sticky-atc-title{font-size:14px;font-weight:700;color:#1a1a1a;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
  .nas-sticky-atc-price{font-size:13px;color:#6E100F;font-weight:800}
  .nas-sticky-atc-price s{color:#999;font-weight:400;margin-left:6px}
  .nas-sticky-atc-btn{background:#6E100F;color:#fff;font-family:'Figtree',sans-serif;font-size:13px;font-weight:700;text-transform:uppercase;letter-spacing:.5px;padding:13px 22px;border-radius:50px;border:none;cursor:pointer;white-space:nowrap;flex-shrink:0}
  .nas-sticky-atc-btn:hover{background:#550c0b}

  .nas-cart-overlay{position:fixed;inset:0;background:rgba(0,0,0,0.4);z-index:90;opacity:0;visibility:hidden;transition:opacity .25s ease}
  .nas-cart-overlay.nas-cart-open{opacity:1;visibility:visible}
  .nas-cart-drawer{position:fixed;top:0;right:0;bottom:0;width:420px;max-width:92vw;background:#fff;z-index:91;display:flex;flex-direction:column;transform:translateX(100%);transition:transform .3s ease;box-shadow:-8px 0 30px rgba(0,0,0,0.12)}
  .nas-cart-drawer.nas-cart-open{transform:translateX(0)}
  .nas-cart-header{display:flex;align-items:center;justify-content:space-between;padding:20px 22px;border-bottom:1px solid #eee}
  .nas-cart-title{font-family:'Figtree',sans-serif;font-size:20px;font-weight:800;color:#1a1a1a;margin:0}
  .nas-cart-title span{color:#6E100F}
  .nas-cart-close{background:none;border:none;cursor:pointer;color:#1a1a1a;width:32px;height:32px;display:flex;align-items:center;justify-content:center;padding:0}
  .nas-cart-close svg{width:20px;height:20px}
  .nas-cart-shipping-bar{background:#FDF2F0;color:#6E100F;font-size:13px;font-weight:600;text-align:center;padding:10px 16px;border-bottom:2px solid #6E100F}
  .nas-cart-items{flex:1;overflow-y:auto;padding:16px 22px}
  .nas-cart-item{display:flex;gap:14px;padding:16px 0;border-bottom:1px solid #f2f2f2}
  .nas-cart-item:last-child{border-bottom:none}
  .nas-cart-item-img{width:72px;height:72px;border-radius:10px;object-fit:cover;background:#f5f0ed;flex-shrink:0}
  .nas-cart-item-main{flex:1;min-width:0}
  .nas-cart-item-title{font-size:14px;font-weight:700;color:#1a1a1a;margin:0 0 4px 0;line-height:1.3}
  .nas-cart-item-variant{font-size:12.5px;color:#888;margin:0 0 8px 0}
  .nas-cart-item-qty{display:inline-flex;align-items:center;border:1px solid #e5e0dc;border-radius:20px;overflow:hidden}
  .nas-cart-item-qty button{width:26px;height:26px;border:none;background:#fff;cursor:pointer;font-size:15px;color:#1a1a1a;display:flex;align-items:center;justify-content:center;padding:0}
  .nas-cart-item-qty button:hover{background:#f5f0ed}
  .nas-cart-item-qty span{min-width:24px;text-align:center;font-size:13px;font-weight:700}
  .nas-cart-item-remove{background:none;border:none;color:#999;font-size:12px;cursor:pointer;margin-left:10px;text-decoration:underline;padding:0}
  .nas-cart-item-price{text-align:right;flex-shrink:0}
  .nas-cart-item-price-sale{display:block;font-size:14px;font-weight:800;color:#6E100F}
  .nas-cart-item-price-compare{display:block;font-size:12px;color:#999;text-decoration:line-through}
  .nas-cart-empty{text-align:center;color:#888;font-size:14px;padding:60px 22px}
  .nas-cart-footer{border-top:1px solid #eee;padding:18px 22px;padding-bottom:calc(18px + env(safe-area-inset-bottom, 0px))}
  .nas-cart-total-row{display:flex;justify-content:space-between;align-items:baseline;font-size:16px;font-weight:800;color:#1a1a1a;margin-bottom:6px}
  .nas-cart-total-row span:last-child{font-size:20px;color:#6E100F}
  .nas-cart-trust{font-size:12.5px;color:#888;text-align:center;margin:0 0 14px 0}
  .nas-cart-checkout-btn{display:flex;align-items:center;justify-content:center;gap:8px;background:#6E100F;color:#fff;font-family:'Figtree',sans-serif;font-size:14px;font-weight:700;text-transform:uppercase;letter-spacing:.5px;padding:16px;border-radius:50px;text-decoration:none;transition:background .2s}
  .nas-cart-checkout-btn:hover{background:#550c0b}

  @media(max-width:480px){.nas-cart-drawer{width:100%;max-width:100%}}

  @media(max-width:768px){
    .nas-promo-bar{padding:10px 12px}
    .nas-promo-bar-title{font-size:18px;flex-basis:100%}
    .nas-promo-bar-tag{font-size:11.5px;padding:4px 10px}
    .nas-promo-bar-end{font-size:13px}
    .nas-promo-bar-timer{font-size:15px;padding:3px 9px}
    .nas-header{padding:14px 16px}
    .nas-header-logo img{height:22px}
    .nas-mobile-nav a{padding:14px 16px}
    .nas-footer-inner{grid-template-columns:1fr;gap:32px}
    .nas-sticky-atc-title{display:none}
  }
</style>
</head>
<body class="gradient">

<div class="nas-promo-bar">
  <div class="nas-promo-bar-inner">
    <span class="nas-promo-bar-title">&#127875; Offre d'<em>Halloween</em></span>
    <span class="nas-promo-bar-tag">Dernière chance</span>
    <span class="nas-promo-bar-end">Fin dans <span class="nas-promo-bar-timer" id="nas-promo-timer">60:00</span></span>
  </div>
</div>
<script>
(function(){
  var timerEl = document.getElementById('nas-promo-timer');
  if (!timerEl) return;
  var KEY = 'nasAutumnOfferEnd';
  var ONE_HOUR = 3600000;
  function getEnd() {
    var stored = parseInt(localStorage.getItem(KEY), 10);
    var now = Date.now();
    if (!stored || isNaN(stored) || stored <= now) {
      stored = now + ONE_HOUR;
      try { localStorage.setItem(KEY, stored); } catch(e) {}
    }
    return stored;
  }
  var end = getEnd();
  function tick() {
    var now = Date.now();
    var diff = end - now;
    if (diff <= 0) {
      end = getEnd();
      diff = end - now;
    }
    var m = Math.floor(diff / 60000);
    var s = Math.floor((diff % 60000) / 1000);
    function pad(n) { return (n < 10 ? '0' : '') + n; }
    timerEl.textContent = pad(m) + ':' + pad(s);
  }
  tick();
  setInterval(tick, 1000);
})();
</script>

<header class="nas-header">
  <button type="button" class="nas-header-menu-btn" id="nas-menu-toggle" aria-label="Menu" aria-expanded="false">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="3" y1="6" x2="21" y2="6"></line><line x1="3" y1="12" x2="21" y2="12"></line><line x1="3" y1="18" x2="21" y2="18"></line></svg>
  </button>
  <a href="{{ routes.root_url }}" class="nas-header-logo">
    <img src="https://cdn.shopify.com/s/files/1/1013/1783/7187/files/nasely-logo-cropped.png?v=1790623998" alt="Nasely">
  </a>
  <div class="nas-header-actions">
    <a href="{{ routes.search_url }}" class="nas-header-icon-btn" aria-label="{{ 'general.search.placeholder' | t }}">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="7"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
    </a>
    <a href="{{ routes.cart_url }}" class="nas-header-icon-btn" id="nas-cart-trigger" aria-label="{{ 'general.cart.view' | t: count: cart.item_count }}">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="21" r="1"></circle><circle cx="20" cy="21" r="1"></circle><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path></svg>
      <span class="nas-header-cart-count" id="nas-header-cart-count"{% if cart.item_count == 0 %} style="display:none"{% endif %}>{{ cart.item_count }}</span>
    </a>
  </div>
</header>

<div class="nas-cart-overlay" id="nas-cart-overlay"></div>
<aside class="nas-cart-drawer" id="nas-cart-drawer" aria-hidden="true">
  <div class="nas-cart-header">
    <h2 class="nas-cart-title">Panier <span id="nas-cart-count">{{ cart.item_count }}</span></h2>
    <button type="button" class="nas-cart-close" id="nas-cart-close" aria-label="Fermer">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
    </button>
  </div>
  <div class="nas-cart-shipping-bar">Livraison à domicile en 5 à 8 jours <strong>OFFERTE</strong></div>
  <div class="nas-cart-items" id="nas-cart-items"></div>
  <p class="nas-cart-empty" id="nas-cart-empty"{% if cart.item_count > 0 %} hidden{% endif %}>Votre panier est vide.</p>
  <div class="nas-cart-footer" id="nas-cart-footer"{% if cart.item_count == 0 %} hidden{% endif %}>
    <div class="nas-cart-total-row">
      <span>Total estimé</span>
      <span id="nas-cart-total">{{ cart.total_price | money }}</span>
    </div>
    <p class="nas-cart-trust">90 jours d'essai &middot; 100% satisfait ou remboursé</p>
    <a href="/checkout" class="nas-cart-checkout-btn">&#128274; Procéder au paiement</a>
  </div>
</aside>
<nav class="nas-mobile-nav" id="nas-mobile-nav">
  <a href="{{ routes.root_url }}">Accueil</a>
  <a href="/products/extrait-de-cerise-griotte">Extrait de Cerise Griotte</a>
  <a href="/pages/contact">Contact</a>
</nav>
<script>
(function(){
  var btn = document.getElementById('nas-menu-toggle');
  var nav = document.getElementById('nas-mobile-nav');
  if (btn && nav) {
    btn.addEventListener('click', function() {
      var open = nav.classList.toggle('nas-nav-open');
      btn.setAttribute('aria-expanded', open ? 'true' : 'false');
    });
  }
})();
</script>

<main id="MainContent">
  {{ content_for_layout }}
</main>

<footer class="nas-footer">
  <div class="nas-footer-inner">
    <div class="nas-footer-brand"><img src="https://cdn.shopify.com/s/files/1/1013/1783/7187/files/nasely-logo-cropped.png?v=1790623998" alt="{{ shop.name }}"></div>
    <div>
      <h3 class="nas-footer-heading">Avez-vous besoin d'aide ?</h3>
      <div class="nas-footer-links">
        <a href="/pages/contact">Contact</a>
        <a href="/pages/informations-expedition">Informations sur l'expédition</a>
        <a href="/pages/retours-remboursements">Retour et Remboursements</a>
        <a href="/pages/politique-confidentialite">Politique de Confidentialité</a>
        <a href="/pages/termes-et-conditions">Termes et Conditions</a>
        <a href="/pages/mentions-legales">Mentions Légales</a>
      </div>
    </div>
    <div>
      <h3 class="nas-footer-heading">Assistance clientèle 24h/24 et 7j/7</h3>
      <p class="nas-footer-contact-email">hellonasely@gmail.com</p>
      <p class="nas-footer-contact-text">Assistance rapide et conviviale, tous les jours de l'année. Nous répondons à toutes vos questions et résolvons tous vos problèmes sous 24 heures.</p>
    </div>
  </div>
  <div class="nas-footer-bottom">&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}</div>
</footer>

{% if template contains 'product' %}
<div class="nas-sticky-atc" id="nas-sticky-atc">
  <div class="nas-sticky-atc-inner">
    {%- if product.featured_media -%}<img class="nas-sticky-atc-img" src="{{ product.featured_media.preview_image | image_url: width: 96 }}" alt="">{%- endif -%}
    <div class="nas-sticky-atc-info">
      <div class="nas-sticky-atc-title">{{ product.title }}</div>
      <div class="nas-sticky-atc-price">{{ product.selected_or_first_available_variant.price | money }}{% if product.selected_or_first_available_variant.compare_at_price > product.selected_or_first_available_variant.price %}<s>{{ product.selected_or_first_available_variant.compare_at_price | money }}</s>{% endif %}</div>
    </div>
    <button type="button" class="nas-sticky-atc-btn" id="nas-sticky-atc-btn">{{ 'products.product.add_to_cart' | t }}</button>
  </div>
</div>
<script>
(function() {
  var bar = document.getElementById('nas-sticky-atc');
  var btn = document.getElementById('nas-sticky-atc-btn');
  var mainForm = document.getElementById('nas-pm-form');
  if (!bar) return;
  var trigger = document.querySelector('.nas-pm-form .nas-pm-cta') || document.querySelector('.nas-pm-cta');
  if (trigger) {
    var io = new IntersectionObserver(function(entries) {
      entries.forEach(function(entry) {
        bar.classList.toggle('nas-sticky-atc-visible', !entry.isIntersecting && entry.boundingClientRect.top < 0);
      });
    }, { threshold: 0 });
    io.observe(trigger);
  }
  if (btn && mainForm) {
    btn.addEventListener('click', function() {
      mainForm.requestSubmit ? mainForm.requestSubmit() : mainForm.submit();
    });
  }
})();
</script>
{% endif %}

